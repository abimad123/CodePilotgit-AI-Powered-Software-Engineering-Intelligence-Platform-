# Copy to .env and replace the password before starting Compose.
POSTGRES_DB=codepilotgit
POSTGRES_USER=codepilotgit
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_LOCAL_PASSWORD
POSTGRES_PORT=5432
REDIS_PORT=6379
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
JWT_ISSUER=codepilotgit
JWT_AUDIENCE=codepilotgit-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8080

# Optional Stage 1 GitHub App settings. Leave empty until a real App is registered.
# GITHUB_APP_NAME is the App slug used in /apps/<slug>/installations/new.
# Configure the App Setup URL separately as http://localhost:5173/github/setup.
# Disable "Request user authorization (OAuth) during installation" in App settings.
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/github/callback
AI_PROVIDER_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
